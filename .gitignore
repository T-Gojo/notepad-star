#-------------------------------------------------------------------------------
# Notepad Star
#
# The application workspace lives at the repository root. Everything the build
# generates is ignored; everything under reference/ is upstream material whose
# own generated outputs are ignored further down.
#-------------------------------------------------------------------------------

#-- Rust workspace and native build outputs
/target/
/build/
/dist/

#-- Cargo.lock is committed on purpose: releases must be reproducible.
!/Cargo.lock

#-- Local tool logs
aqtinstall.log
build-log.txt

#-------------------------------------------------------------------------------
# Editors, IDEs and operating systems
#-------------------------------------------------------------------------------
.vs/
.vscode/
*.suo
*.user
*.sln.docstates
*.aps
*.ncb
*.opensdf
*.sdf
*.cachefile
ipch/
_UpgradeReport_Files/
Backup*/
UpgradeLog*.XML
UpgradeLog*.htm
.builds
*.pidb
*.vcxproj.filters
*.bak
*.tmp
*.tmp_proj
*~
*.swp
Thumbs.db
Desktop.ini
folder-*.ico
$RECYCLE.BIN/
*.DS_Store

#-------------------------------------------------------------------------------
# Compiled artefacts (never committed anywhere in this repository)
#-------------------------------------------------------------------------------
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Oo]bj/
bin.*
*.exe
*.obj
*.o
*.pch
*.pdb
*.ilk
*.meta
*.pgc
*.pgd
*.rsp
*.sbr
*.tlb
*.tli
*.tlh
*_i.c
*_p.c
*.db
*.opendb

