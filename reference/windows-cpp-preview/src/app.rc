#include <windows.h>
#include "resource.h"

1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK 0x3f
FILEFLAGS VS_FF_PRERELEASE
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "ProductName", "Notepad Star"
			VALUE "FileDescription", "Notepad Star development preview"
			VALUE "FileVersion", "0.1.0.0"
			VALUE "ProductVersion", "0.1.0.0"
			VALUE "OriginalFilename", "notepad-star.exe"
			VALUE "LegalCopyright", "Notepad Star contributors; GPL-3.0-or-later"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END

ID_APP_MENU MENU
BEGIN
	POPUP "&File"
	BEGIN
		MENUITEM "&New\tCtrl+N", ID_NEW
		MENUITEM "&Open...\tCtrl+O", ID_OPEN
		MENUITEM SEPARATOR
		MENUITEM "&Save\tCtrl+S", ID_SAVE
		MENUITEM "Save &As...\tCtrl+Shift+S", ID_SAVE_AS
		MENUITEM "Save A&ll\tCtrl+Alt+S", ID_SAVE_ALL
		MENUITEM SEPARATOR
		MENUITEM "&Close Tab\tCtrl+W", ID_CLOSE_TAB
		MENUITEM "E&xit\tAlt+F4", ID_EXIT
	END
	POPUP "&Edit"
	BEGIN
		MENUITEM "&Undo\tCtrl+Z", ID_UNDO
		MENUITEM "&Redo\tCtrl+Y", ID_REDO
		MENUITEM SEPARATOR
		MENUITEM "Cu&t\tCtrl+X", ID_CUT
		MENUITEM "&Copy\tCtrl+C", ID_COPY
		MENUITEM "&Paste\tCtrl+V", ID_PASTE
		MENUITEM "Select &All\tCtrl+A", ID_SELECT_ALL
	END
	POPUP "&Search"
	BEGIN
		MENUITEM "&Find / Replace\tCtrl+F", ID_FIND
		MENUITEM "Find &Next\tF3", ID_FIND_NEXT
		MENUITEM "Find &Previous\tShift+F3", ID_FIND_PREVIOUS
	END
	POPUP "&View"
	BEGIN
		MENUITEM "&Word Wrap\tAlt+Z", ID_WRAP
		MENUITEM "&Dark Editor", ID_DARK
		MENUITEM SEPARATOR
		MENUITEM "Zoom &In\tCtrl++", ID_ZOOM_IN
		MENUITEM "Zoom &Out\tCtrl+-", ID_ZOOM_OUT
		MENUITEM "&Reset Zoom\tCtrl+0", ID_ZOOM_RESET
		MENUITEM SEPARATOR
		MENUITEM "&Next Tab\tCtrl+Tab", ID_NEXT_TAB
		MENUITEM "&Previous Tab\tCtrl+Shift+Tab", ID_PREVIOUS_TAB
	END
	POPUP "&Language"
	BEGIN
		MENUITEM "&Automatic (file extension)", ID_LANG_AUTO
		MENUITEM "Plain &Text", ID_LANG_TEXT
		MENUITEM SEPARATOR
		MENUITEM "&C / C++", ID_LANG_CPP
		MENUITEM "&JavaScript / TypeScript", ID_LANG_JS
		MENUITEM "&Python", ID_LANG_PYTHON
		MENUITEM "J&SON", ID_LANG_JSON
		MENUITEM "&HTML", ID_LANG_HTML
		MENUITEM "&XML", ID_LANG_XML
		MENUITEM "C&SS", ID_LANG_CSS
		MENUITEM "S&QL", ID_LANG_SQL
		MENUITEM "&Markdown", ID_LANG_MARKDOWN
	END
	POPUP "&Help"
	BEGIN
		MENUITEM "&About Notepad Star", ID_ABOUT
	END
END

ID_APP_ACCEL ACCELERATORS
BEGIN
	"N", ID_NEW, VIRTKEY, CONTROL
	"O", ID_OPEN, VIRTKEY, CONTROL
	"S", ID_SAVE_AS, VIRTKEY, CONTROL, SHIFT
	"S", ID_SAVE_ALL, VIRTKEY, CONTROL, ALT
	"S", ID_SAVE, VIRTKEY, CONTROL
	"W", ID_CLOSE_TAB, VIRTKEY, CONTROL
	"F", ID_FIND, VIRTKEY, CONTROL
	"H", ID_FIND, VIRTKEY, CONTROL
	VK_F3, ID_FIND_PREVIOUS, VIRTKEY, SHIFT
	VK_F3, ID_FIND_NEXT, VIRTKEY
	VK_ESCAPE, ID_HIDE_FIND, VIRTKEY
	"Z", ID_WRAP, VIRTKEY, ALT
	VK_TAB, ID_PREVIOUS_TAB, VIRTKEY, CONTROL, SHIFT
	VK_TAB, ID_NEXT_TAB, VIRTKEY, CONTROL
	VK_OEM_PLUS, ID_ZOOM_IN, VIRTKEY, CONTROL
	VK_OEM_MINUS, ID_ZOOM_OUT, VIRTKEY, CONTROL
	"0", ID_ZOOM_RESET, VIRTKEY, CONTROL
END
